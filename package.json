{
  "name": "cowboy-online",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Cowboy Online: a frontier open world for the browser, set in Calder Territory in 1899. Authoritative server, shared simulation, three.js client.",
  "scripts": {
    "start": "node server/src/node/main.js",
    "build": "node tools/build-client.mjs",
    "dev": "node tools/build-client.mjs --serve",
    "test": "node --test \"test/*.test.js\"",
    "loadtest": "node tools/loadtest/run.mjs",
    "check:client": "node tools/check-client.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "three": "0.128.0"
  },
  "homepage": "https://malachi-nelson.github.io/CowboyOnline/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Malachi-Nelson/CowboyOnline.git"
  }
}
